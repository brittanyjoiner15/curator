NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
GOOGLE_API_KEY=your_google_api_key

# ANTHROPIC_API_KEY is no longer needed here — each user provides their own via /settings

# Jina Reader (r.jina.ai) for page text extraction. Optional — works keyless
# with low rate limits. Get a free key at https://jina.ai
JINA_API_KEY=jina***

# PostHog analytics (project token from PostHog project settings)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# PostHog support widget identity verification (optional).
# Generate in PostHog: Settings -> Project -> Secret API token. Server-only, never NEXT_PUBLIC_.
POSTHOG_SECRET_API_TOKEN=phs_...
